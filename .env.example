# ==============================================================================
# YTdownloader Frontend — Environment Variables Template
# ==============================================================================

# Production Backend API URL
# Set this to your deployed Render backend service URL:
# Example: VITE_API_URL=https://ytdownloader-backend.onrender.com
# If left empty, the frontend defaults to '/api' (ideal for local dev with Vite proxy or single-service hosting)
VITE_API_URL=
